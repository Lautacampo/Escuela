{
"$schema": "https://opencode.ai/config.json",
"permission": {
"bash": {
"*": "ask",
"git status*": "allow",
"git diff*": "allow",
"git log*": "allow",
"git add*": "allow",
"git commit*": "allow",
"git checkout -b*": "allow",
"git push*": "ask",
"gh pr create*": "ask",
"gh pr merge*": "ask",
"git push --force*": "deny",
"git push -f*": "deny",
"git reset --hard*": "deny"
}
}
}