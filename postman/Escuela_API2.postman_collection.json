          "name": "Login Directivo (Éxito 200 - Guarda token automáticamente)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.token) {",
                  "    pm.collectionVariables.set('token', res.token);",
                  "    console.log('Token guardado automáticamente en {{token}}');",
                  "}",
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"director@escuela.com\",\n  \"password\": \"1234\"\n}",
              "options": {
