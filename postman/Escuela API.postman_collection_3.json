              "raw": "{\n  \"email\": \"director@escuela.com\",\n  \"password\": \"1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "if (j.token) pm.collectionVariables.set(\"token\", j.token);"
                ]
