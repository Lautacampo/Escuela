                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const cursos = pm.response.json();",
                  "pm.test(\"Hay al menos un curso con módulos\", () => pm.expect(cursos[0].modulos.length).to.be.above(0));",
